A slow first frame is not a disconnect (mu-engine/patches/net-0003; Melee-NX-NetPlay's patches/net-0007, as melee-unlocked does
it: its should_skip_online_frame): until the other player's first online frame has arrived, the netplay object waits 30 s for
it before dropping that player; after it, Slippi's 7 s as before. The rule is local: nothing on the wire changes. Tests only:
MELEE_NET_TEST_SLOW_FIRST_FRAME_MS holds this side's first online frame that long. Applied by ../net_sources.sh.

diff -ruN a/port/runtime/hle/slippi_online.cpp b/port/runtime/hle/slippi_online.cpp
--- a/port/runtime/hle/slippi_online.cpp
+++ b/port/runtime/hle/slippi_online.cpp
@@ -46,6 +46,7 @@
 #include "window.h"
 #include <algorithm>
 #include <array>
+#include <chrono>
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
@@ -259,8 +260,11 @@
     if (enough) { g_stall_frame_counts[i] = 0; continue; }
     g_stall_frame_counts[i]++;
     any_needs_inputs = true;
-    if (g_stall_frame_counts[i] > 60 * 7) {
-      host::log("slippi: force-disconnecting player %u after 7 s stall (frame %d, latest %d)", pad->player_idx, frame, latest);
+    // mu-engine/patches/net-0003 (melee-unlocked's slow first frame): before the other player's first frame arrives (a stage
+    // load on a slow machine took 13 s for one of upstream's players) the limit is 30 s; after it Slippi's 7 s.
+    const int stall_limit = latest < 1 ? 60 * 30 : 60 * 7;
+    if (g_stall_frame_counts[i] > (uint32_t)stall_limit) {
+      host::log("slippi: force-disconnecting player %u after %d s stall (frame %d, latest %d)", pad->player_idx, stall_limit / 60, frame, latest);
       g_netplay->ForceDisconnectPlayer(pad->player_idx);
       g_stall_frame_counts[i] = 0;
       continue;
@@ -435,6 +439,12 @@
   uint8_t delay = payload[12];
   const uint8_t* inputs = payload + 13;
   if (frame == 1) {
+    // mu-engine/patches/net-0003, tests only: MELEE_NET_TEST_SLOW_FIRST_FRAME_MS holds this side's first online frame that long,
+    // as a slow stage load would (the other side must wait for it instead of dropping this player).
+    if (const char* slow = std::getenv("MELEE_NET_TEST_SLOW_FIRST_FRAME_MS")) {
+      const int ms = std::atoi(slow);
+      if (ms > 0 && ms <= 60000) { host::log("slippi: test aid: the first online frame waits %d ms", ms); std::this_thread::sleep_for(std::chrono::milliseconds(ms)); }
+    }
     g_available_savestates.clear();
     g_active_savestates.clear();
     for (int i = 0; i < ROLLBACK_MAX_FRAMES; ++i) g_available_savestates.push_back(std::make_unique<Savestate>());
