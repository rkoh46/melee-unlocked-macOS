+// mu-engine/patches/net-0001 (Melee-NX-NetPlay's net-0005 and net-0010). Simulation thread, as the game's own 0xB3 is.
+SearchInfo search_info() {
+  SearchInfo out;
+  if (g_offline || !g_matchmaking) return out;
+  out.state = !g_forced_error.empty() ? (int)Matchmaking::ERROR_ENCOUNTERED : (int)g_matchmaking->GetMatchmakeState();
+  out.mode = (int)g_last_search.mode;
+  out.locked = g_local_selections.is_character_selected;
+  out.character = out.locked ? (int)g_local_selections.character_id : -1;
+  out.color = g_local_selections.character_color;
+  out.kept = g_search_kept;
+  out.code = shiftjis_to_utf8(g_last_search.connect_code);
+  if (out.state == (int)Matchmaking::CONNECTION_SUCCESS && g_netplay && g_netplay->GetSlippiConnectStatus() == NetplayClient::ConnectStatus::CONNECTED) {
+    const MatchInfo* mi = g_netplay->GetMatchInfo();
+    const int remotes = (int)g_matchmaking->RemotePlayerCount();
+    out.remote_ready = remotes > 0;
+    for (int i = 0; i < remotes && i < REMOTE_PLAYER_MAX; ++i) if (!mi->remote[i].is_character_selected) out.remote_ready = false;
+    for (int i = 0; i < remotes && i < REMOTE_PLAYER_MAX && out.remote_character < 0; ++i)
+      if (mi->remote[i].is_character_selected && mi->remote[i].character_id < 26) { out.remote_character = mi->remote[i].character_id; out.remote_color = mi->remote[i].character_color; }
+  }
+  out.elapsed_ms = g_search_started_ms ? (uint32_t)std::min<uint64_t>(time_ms() - g_search_started_ms, 0xFFFFFFFFu) : 0;
+  if (out.state == (int)Matchmaking::ERROR_ENCOUNTERED) out.error = !g_forced_error.empty() ? g_forced_error : g_matchmaking->GetErrorMessage();
+  if (out.state >= (int)Matchmaking::OPPONENT_CONNECTING) {
+    const std::vector<UserInfo> players = g_matchmaking->GetPlayerInfo();
+    for (int i = 0; i < (int)players.size(); ++i)
+      if (i != g_matchmaking->LocalPlayerIndex()) { if (!out.opponent.empty()) out.opponent += ", "; out.opponent += players[i].display_name; }
+  }
+  return out;
+}
+void keep_search(bool kept) {
+  if (g_search_kept == kept) return;
+  g_search_kept = kept;
+  host::log("slippi: kept search: %s", kept ? "the player left the select; the search goes on" : "back on the select");
+}
+bool search_kept() { return g_search_kept; }
+void end_kept_search(const char* why) {
+  host::log("slippi: kept search over: %s", why ? why : "");
+  g_search_kept = false;
+  cleanup_connection();
+}
+void frame_trace(int* skip, bool* advanced, int32_t* offset_us) { *skip = g_trace_skip; *advanced = g_trace_advanced; *offset_us = g_trace_offset_us; }
 
