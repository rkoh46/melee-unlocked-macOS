+std::vector<std::string> User::GetUserChatMessages() const {
+  const UserInfo me = GetUserInfo();   // mu-engine/patches/net-0004: the refreshed messages count
+  return me.chat_messages.size() == 16 ? me.chat_messages : GetDefaultChatMessages();
+}
+// mu-engine/patches/net-0004
+UserInfo User::GetUserInfo() const {
+  UserInfo out = info_;
+  std::lock_guard<std::mutex> lk(refreshed_->m);
+  const Refreshed& r = *refreshed_;
+  if (!r.done || r.uid != out.uid || !logged_in_) return out;
+  if (!r.name.empty()) out.display_name = r.name;
+  if (!r.code.empty()) out.connect_code = r.code;
+  if (!r.latest.empty()) out.latest_version = r.latest;
+  if (r.chat.size() == 16) out.chat_messages = r.chat;
+  return out;
+}
+void User::RefreshFromServer() {
+  if (info_.uid.empty()) return;
+  std::shared_ptr<Refreshed> state = refreshed_;
+  std::thread([state, uid = info_.uid] {
+    try {
+      std::string response;
+      int status = 0;
+      const std::string url = report::users_url() + uid + "?additionalFields=chatMessages";
+      if (!report::http_request("GET", url, "", "", &status, &response) || status != 200) {
+        host::log("slippi: profile refresh unavailable (HTTP %d); keeping user.json", status);
+        return;
+      }
+      const json j = json::parse(response, nullptr, false);
+      if (!j.is_object()) { host::log("slippi: profile refresh: unexpected response; keeping user.json"); return; }
+      std::vector<std::string> chat;   // all sixteen must be text, or the stored messages stay
+      if (j.count("chatMessages") && j["chatMessages"].is_array() && j["chatMessages"].size() == 16)
+        for (const auto& m : j["chatMessages"]) if (m.is_string()) chat.push_back(m.get<std::string>());
+      std::lock_guard<std::mutex> lk(state->m);
+      state->uid = uid;
+      state->name = jget(j, "displayName", "");
+      state->code = jget(j, "connectCode", "");
+      state->latest = jget(j, "latestVersion", "");
+      if (chat.size() == 16) state->chat = std::move(chat);
+      state->done = true;
+      host::log("slippi: profile refreshed from Slippi's user service: %s (%s)%s%s%s", state->name.c_str(), state->code.c_str(),
+                state->chat.size() == 16 ? ", its 16 chat messages" : "", state->latest.empty() ? "" : ", servers on ", state->latest.c_str());
+    } catch (...) {
+      host::log("slippi: profile refresh failed; keeping user.json");
+    }
+  }).detach();
+}
